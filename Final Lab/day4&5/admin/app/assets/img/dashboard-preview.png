<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <!-- Background -->
  <rect width="800" height="600" fill="#f8f9fa"/>
  
  <!-- Sidebar -->
  <rect x="0" y="0" width="200" height="600" fill="#0f172a"/>
  
  <!-- Sidebar items -->
  <rect x="20" y="80" width="160" height="40" rx="5" fill="#0ea5a4" opacity="0.8"/>
  <rect x="20" y="140" width="160" height="40" rx="5" fill="#0ea5a4" opacity="0.6"/>
  <rect x="20" y="200" width="160" height="40" rx="5" fill="#0ea5a4" opacity="0.6"/>
  <rect x="20" y="260" width="160" height="40" rx="5" fill="#0ea5a4" opacity="0.6"/>
  
  <!-- Main content area -->
  <rect x="220" y="20" width="560" height="560" fill="#ffffff"/>
  
  <!-- Header -->
  <rect x="240" y="40" width="200" height="30" fill="#e9ecef"/>
  <circle cx="720" cy="55" r="12" fill="#dcdcdc"/>
  
  <!-- Cards -->
  <rect x="240" y="100" width="160" height="100" fill="#e9ecef" rx="8"/>
  <rect x="420" y="100" width="160" height="100" fill="#e9ecef" rx="8"/>
  <rect x="600" y="100" width="160" height="100" fill="#e9ecef" rx="8"/>
  
  <!-- Table mockup -->
  <rect x="240" y="220" width="520" height="30" fill="#f8f9fa"/>
  <rect x="240" y="250" width="520" height="30" fill="#ffffff"/>
  <rect x="240" y="280" width="520" height="30" fill="#f8f9fa"/>
  <rect x="240" y="310" width="520" height="30" fill="#ffffff"/>
  <rect x="240" y="340" width="520" height="30" fill="#f8f9fa"/>
  
  <!-- Chart area -->
  <rect x="240" y="390" width="520" height="180" fill="#f8f9fa"/>
  <rect x="260" y="450" width="40" height="80" fill="#0ea5a4"/>
  <rect x="320" y="420" width="40" height="110" fill="#0ea5a4"/>
  <rect x="380" y="480" width="40" height="50" fill="#0ea5a4"/>
  <rect x="440" y="400" width="40" height="130" fill="#0ea5a4"/>
  <rect x="500" y="460" width="40" height="70" fill="#0ea5a4"/>
  <rect x="560" y="430" width="40" height="100" fill="#0ea5a4"/>
  <rect x="620" y="470" width="40" height="60" fill="#0ea5a4"/>
  <rect x="680" y="410" width="40" height="120" fill="#0ea5a4"/>
</svg>